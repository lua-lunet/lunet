# syntax=docker/dockerfile:1
#
# Shared base for the edge examples: the realworld-lua demo app (v0.18.1,
# matched to lunet v0.18.1) on Debian trixie, with nginx installed and
# configured as the reference edge. The per-edge Dockerfiles next to this
# file are FROM this base and swap in their own edge server.
#
# Native architecture: the lunet fetcher auto-detects uname -m, so the
# image builds as linux/arm64 on Apple Silicon (colima) and linux/amd64
# elsewhere. No emulation.
#
# Build from the repository root of THIS repo (the lunet source tree):
#
#   docker build -f ext/http/edge/Dockerfile.base -t lunet-edge-base ext/http/edge
#
FROM debian:trixie-slim

ENV DEBIAN_FRONTEND=noninteractive

# Runtime deps for the lun release archives (libpq5 for the postgres
# driver, libuv1, libsqlite3, libluajit); lua5.1 + curl + ca-certificates
# for the release fetcher; git to pull the pinned app tag; nginx as the
# reference edge.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        lua5.1 \
        git \
        libpq5 \
        libuv1 \
        libsqlite3-0 \
        libluajit-5.1-2 \
        nginx \
    && rm -rf \
 /var/lib/apt/lists/*

# The pinned app: realworld-lua v0.18.1 (sister release matched to lunet
# v0.18.1). The fetcher digest-verifies the lunet runtime into .lunet/.
WORKDIR /app
RUN git clone --depth 1 --branch v0.18.1 \
        https://github.com/lua-lunet/realworld-lua . \
    && lua5.1 scripts/lunet_fetch_release_v0.18.1.lua \
    && chmod +x start.sh

# The reference edge configuration (security-oriented: request buffering
# on, body cap, tightened read timeouts, loopback-only upstream).
COPY conf/nginx-edge.conf /etc/nginx/nginx-edge.conf

# Start the app (loopback TCP inside the container namespace - the app's
# pinned server.lua listens on host:port; the edge is the only process
# with a container-external listener) and then the edge in the foreground.
COPY entrypoint-edge.sh /usr/local/bin/entrypoint-edge.sh
RUN chmod +x /usr/local/bin/entrypoint-edge.sh

# PGDATABASE etc. come from the environment at run time (docker run or
# compose); see run-conformance.sh.
ENV LUNET_PORT=8081
ENV EDGE_KIND=nginx

EXPOSE 80

ENTRYPOINT ["/usr/local/bin/entrypoint-edge.sh"]
