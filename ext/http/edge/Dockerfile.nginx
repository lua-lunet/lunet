# syntax=docker/dockerfile:1
#
# Edge example: nginx. The base image already ships nginx with the
# security-oriented configuration (conf/nginx-edge.conf), so this variant
# does nothing except set the edge kind. It exists so the conformance suite
# treats all four edges identically: same base, same entrypoint contract.
#
#   docker build -f ext/http/edge/Dockerfile.nginx -t lunet-edge-nginx ext/http/edge
#
FROM lunet-edge-base

ENV EDGE_KIND=nginx
