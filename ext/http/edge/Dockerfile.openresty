# syntax=docker/dockerfile:1
#
# Edge example: OpenResty. Same nginx lineage and directive semantics as
# the base image's nginx, with the Lua scripting doors available at the
# edge. The configuration (conf/openresty-edge.conf) mirrors
# conf/nginx-edge.conf.
#
#   docker build -f ext/http/edge/Dockerfile.openresty -t lunet-edge-openresty ext/http/edge
#
# The base image is native-arch, but OpenResty's official apt repository
# publishes amd64 packages only (no arm64), so this variant is pinned to
# linux/amd64 - on Apple Silicon, Docker builds and runs it under
# emulation. This mirrors the realworld-lua project's own Dockerfile,
# which stays pinned to linux/amd64 for the same reason.
# Built by the driver as:
#   docker build --platform linux/amd64 -f Dockerfile.base -t lunet-edge-base:amd64 ext/http/edge
FROM --platform=linux/amd64 lunet-edge-base:amd64

# OpenResty's official apt repository. It does not publish a trixie suite
# yet (bookworm is current), and its repository signature still uses SHA1,
# which trixie's stricter apt (sqv) rejects outright. For this illustration
# the repo is marked trusted=yes; a production image should pin and verify
# the .deb instead.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        gnupg \
    && curl -fsSL https://openresty.org/package/pubkey.gpg \
        | gpg --dearmor -o /usr/share/keyrings/openresty.gpg \
    && echo "deb [trusted=yes] http://openresty.org/package/debian bookworm openresty" \
        > /etc/apt/sources.list.d/openresty.list \
    && apt-get update && apt-get install -y --no-install-recommends openresty \
    && rm -rf /var/lib/apt/lists/*

COPY conf/openresty-edge.conf /usr/local/openresty/nginx/conf/nginx-edge.conf

ENV EDGE_KIND=openresty
